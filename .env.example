# ===========================================
# SICA — Sage Investor Council Agent
# ===========================================
# Copy this file to .env and fill in your values

# --- Required ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Email (choose one method) ---
# SMTP (e.g., Gmail)
EMAIL_METHOD=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@example.com

# SendGrid (alternative)
# EMAIL_METHOD=sendgrid
# SENDGRID_API_KEY=your_sendgrid_key_here
# EMAIL_FROM=your_email@example.com
# EMAIL_TO=recipient@example.com

# --- Free Data APIs ---
# FRED (free, get key at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# SEC EDGAR (free, just needs your email for User-Agent)
SEC_EDGAR_USER_AGENT=YourName your_email@example.com

# --- Optional Paid Data APIs ---
# Alpha Vantage (free tier: 25 requests/day)
# ALPHA_VANTAGE_API_KEY=your_key_here

# Finnhub (free tier: 60 calls/min)
# FINNHUB_API_KEY=your_key_here

# Polygon.io (free tier: 5 calls/min)
# POLYGON_API_KEY=your_key_here

# NewsAPI (free tier: 100 requests/day)
# NEWSAPI_KEY=your_key_here

# --- Model Configuration ---
CLAUDE_MODEL=claude-sonnet-4-20250514
# For higher quality analysis (more expensive):
# CLAUDE_MODEL=claude-opus-4-20250514
